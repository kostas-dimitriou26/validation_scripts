[
  {
    "key": "ctrl+enter",
    "command": "python.execSelectionInTerminal",
    "when": "editorTextFocus && editorLangId == 'python' && editorHasSelection"
  },
  {
    "key": "ctrl+enter",
    "command": "python.execInTerminal",
    "when": "editorTextFocus && editorLangId == 'python' && !editorHasSelection"
  }
]
